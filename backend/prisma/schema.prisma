// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?      @relation("AssignedTasks", fields: [assigneeId], references: [id])
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  

  // Relations
  boardId     String
  board       KanbanBoard @relation(fields: [boardId], references: [id])
  columnId    String?
  column      KanbanColumn? @relation(fields: [columnId], references: [id])

  @@map("tasks")
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  phone     String?  // WhatsApp phone number
  role      Role     @default(EMPLOYEE)
  whatsappNotifications Boolean @default(true) // Enable/disable WhatsApp notifications
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tickets assigned to this user
  assignedTickets Ticket[] @relation("AssignedTo")
  // Tasks assigned to this user
  assignedTasks   Task[]   @relation("AssignedTasks")
  // Tickets created by this user
  createdTickets  Ticket[] @relation("CreatedBy")
  // Comments made by this user
  comments        Comment[]
  // Activities performed by this user
  activities      TicketActivity[]
  // Board permissions for this user
  boardPermissions BoardPermission[]
  // Notifications for this user
  notifications   Notification[]

  @@map("users")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  address     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  applications CustomerApplication[]
  tickets      Ticket[]

  @@map("customers")
}

model Application {
  id          String   @id @default(cuid())
  name        String
  description String?
  version     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  customers CustomerApplication[]
  tickets   Ticket[]

  @@map("applications")
}

model CustomerApplication {
  id            String   @id @default(cuid())
  customerId    String
  applicationId String
  assignedAt    DateTime @default(now())

  // Relations
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([customerId, applicationId])
  @@map("customer_applications")
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  dueDate     DateTime?
  estimatedHours Float?
  actualHours    Float?
  position    Int          @default(0) // For Kanban ordering
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  assignedToId  String?
  assignedTo    User?        @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User         @relation("CreatedBy", fields: [createdById], references: [id])
  customerId    String?
  customer      Customer?    @relation(fields: [customerId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  boardId       String?
  board         KanbanBoard? @relation(fields: [boardId], references: [id])
  comments      Comment[]
  labels        TicketLabel[]
  activities    TicketActivity[]
  notifications Notification[]

  @@map("tickets")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Relations
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@map("comments")
}

model KanbanBoard {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  type        BoardType @default(TICKETS)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  columns     KanbanColumn[]
  tickets     Ticket[]
  tasks       Task[]
  permissions BoardPermission[]

  @@map("kanban_boards")
}

model KanbanColumn {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  // Hex color code
  position    Int
  wipLimit    Int?     // Work in Progress limit
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  boardId String
  board   KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([boardId, position])
  @@map("kanban_columns")
}

model Label {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   // Hex color code
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tickets TicketLabel[]

  @@map("labels")
}

model TicketLabel {
  id       String @id @default(cuid())
  ticketId String
  labelId  String

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([ticketId, labelId])
  @@map("ticket_labels")
}

model TicketActivity {
  id          String       @id @default(cuid())
  action      ActivityType
  description String
  oldValue    String?
  newValue    String?
  createdAt   DateTime     @default(now())

  // Relations
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@map("ticket_activities")
}

model BoardPermission {
  id      String           @id @default(cuid())
  userId  String
  boardId String
  role    BoardPermissionRole

  // Relations
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  board KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
  @@map("board_permissions")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  MOVED
  COMMENTED
  LABEL_ADDED
  LABEL_REMOVED
  DUE_DATE_CHANGED
  PRIORITY_CHANGED
}

enum BoardPermissionRole {
  VIEWER
  EDITOR
  ADMIN
}

enum BoardType {
  TICKETS
  TASKS
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_UPDATED
  TICKET_COMMENTED
  TICKET_DUE_SOON
  TICKET_OVERDUE
  MENTION
  STATUS_CHANGED
}

// Doc Builder models
model Doc {
  id        String   @id @default(cuid())
  title     String
  blocks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  nodes DocNode[]

  @@map("docs")
}

enum DocNodeType {
  FOLDER
  DOC
}

model DocNode {
  id        String      @id @default(cuid())
  type      DocNodeType
  title     String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Self-relation for tree
  parentId String?
  parent   DocNode?     @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children DocNode[]    @relation("ParentChildren")

  // Optional relation to Doc when type == DOC
  docId String?
  doc   Doc?        @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([parentId, position])
  @@map("doc_nodes")
}