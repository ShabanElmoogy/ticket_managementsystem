{
  "name": "ticket-management-backend",
  "version": "1.0.0",
  "description": "Backend for ticket management system",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "npm list express > /dev/null 2>&1 || npm install && node server.js",
    "dev": "nodemon server.js",
    "build": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node drizzle/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node drizzle/seed.js node drizzle/seed-kanban.js",
    "db:reset": "drizzle-kit drop && drizzle-kit push && node drizzle/seed.js",
    "db:test": "node test-db.js",
    "setup": "node setup.js",
    "migrate:tickets": "node migrate-tickets-to-board.js",
    "quick-setup": "npm install && drizzle-kit push && node drizzle/seed.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "bcryptjs": "^2.4.3",
    "chat-app": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.44.7",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "postgres": "^3.4.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "nodemon": "^3.0.1"
  }
}
