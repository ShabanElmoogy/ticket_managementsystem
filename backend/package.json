{
  "name": "ticket-management-backend",
  "version": "1.0.0",
  "description": "Backend for ticket management system",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "npm list express > /dev/null 2>&1 || npm install && node server.js",
    "dev": "nodemon server.js",
    "build": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset",
    "db:test": "node test-db.js",
    "setup": "node setup.js",
    "migrate:tickets": "node migrate-tickets-to-board.js",
    "quick-setup": "npm install && prisma generate && prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^5.6.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "bcryptjs": "^2.4.3",
    "chat-app": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "pino": "^9.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
