{
  "info": {
    "_postman_id": "docs-api-collection",
    "name": "Docs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:3001/api" },
    { "key": "token",     "value": "" },
    { "key": "docId",     "value": "" },
    { "key": "nodeId",    "value": "" },
    { "key": "tenantId",  "value": "" },
    { "key": "tenantSlug","value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Tenants",
      "item": [
        {
          "name": "List Tenants (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/tenants/public", "host": ["{{baseUrl}}"], "path": ["tenants", "public"] }
          }
        },
        {
          "name": "Get Tenant by Slug (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tenants/by-slug/{{tenantSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "by-slug", "{{tenantSlug}}"]
            }
          }
        },
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/tenants", "host": ["{{baseUrl}}"], "path": ["tenants"] }
          }
        },
        {
          "name": "Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('tenantId', json.id);",
                  "  pm.collectionVariables.set('tenantSlug', json.slug);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Tenant\",\n  \"slug\": \"test-tenant\",\n  \"subscriptionPlan\": \"FREE\",\n  \"subscriptionStatus\": \"ACTIVE\",\n  \"subscriptionSeats\": 5,\n  \"supportEmail\": \"support@test-tenant.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tenants", "host": ["{{baseUrl}}"], "path": ["tenants"] }
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Tenant Name\",\n  \"subscriptionPlan\": \"PRO\",\n  \"subscriptionSeats\": 10,\n  \"supportEmail\": \"support@updated.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Get Tenant Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tenants/{{tenantId}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "{{tenantId}}", "stats"]
            }
          }
        },
        {
          "name": "Activate Tenant",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tenants/{{tenantId}}/activate",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "{{tenantId}}", "activate"]
            }
          }
        },
        {
          "name": "Deactivate Tenant",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tenants/{{tenantId}}/deactivate",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "{{tenantId}}", "deactivate"]
            }
          }
        },
        {
          "name": "Delete Tenant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tenants", "{{tenantId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "List Docs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/docs", "host": ["{{baseUrl}}"], "path": ["docs"] }
          }
        },
        {
          "name": "Get Doc by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/docs/{{docId}}", "host": ["{{baseUrl}}"], "path": ["docs", "{{docId}}"] }
          }
        },
        {
          "name": "Create Doc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('docId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Test Doc\",\n  \"blocks\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/docs", "host": ["{{baseUrl}}"], "path": ["docs"] }
          }
        },
        {
          "name": "Update Doc",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Doc Title\",\n  \"blocks\": [{\"id\": \"block-1\", \"type\": \"paragraph\"}]\n}"
            },
            "url": { "raw": "{{baseUrl}}/docs/{{docId}}", "host": ["{{baseUrl}}"], "path": ["docs", "{{docId}}"] }
          }
        },
        {
          "name": "Delete Doc",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/docs/{{docId}}", "host": ["{{baseUrl}}"], "path": ["docs", "{{docId}}"] }
          }
        }
      ]
    },
    {
      "name": "Doc Tree",
      "item": [
        {
          "name": "List Tree",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/docs/tree", "host": ["{{baseUrl}}"], "path": ["docs", "tree"] }
          }
        },
        {
          "name": "Create Folder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('nodeId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Folder\",\n  \"parentId\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/docs/tree/folder", "host": ["{{baseUrl}}"], "path": ["docs", "tree", "folder"] }
          }
        },
        {
          "name": "Create Doc Node",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('nodeId', json.id);",
                  "if (json.docId) pm.collectionVariables.set('docId', json.docId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Doc Node\",\n  \"parentId\": null,\n  \"docId\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/docs/tree/doc", "host": ["{{baseUrl}}"], "path": ["docs", "tree", "doc"] }
          }
        },
        {
          "name": "Rename Node",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed Node\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/docs/tree/{{nodeId}}/rename", "host": ["{{baseUrl}}"], "path": ["docs", "tree", "{{nodeId}}", "rename"] }
          }
        },
        {
          "name": "Move Node",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newParentId\": null,\n  \"newPosition\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/docs/tree/{{nodeId}}/move", "host": ["{{baseUrl}}"], "path": ["docs", "tree", "{{nodeId}}", "move"] }
          }
        },
        {
          "name": "Delete Node",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/docs/tree/{{nodeId}}", "host": ["{{baseUrl}}"], "path": ["docs", "tree", "{{nodeId}}"] }
          }
        }
      ]
    }
  ]
}
