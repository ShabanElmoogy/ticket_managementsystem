# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_SSL=false

# JWT Secrets (REQUIRED - use strong random values in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token Expiry
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# API Documentation
SWAGGER_ENABLED=true

# Security & Rate Limiting
AUTH_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=1mb

# Database Connection Pool
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# Tenant Caching
TENANT_CACHE_MAX=500
TENANT_CACHE_TTL_MS=60000
TENANT_CACHE_MISS_TTL_MS=10000

# Email Ingest (Optional - set ENABLED=true to activate)
EMAIL_INGEST_ENABLED=false
EMAIL_INGEST_HOST=imap.gmail.com
EMAIL_INGEST_PORT=993
EMAIL_INGEST_SECURE=true
EMAIL_INGEST_USER=your-email@domain.com
EMAIL_INGEST_PASSWORD=your-app-password
EMAIL_INGEST_INTERVAL_MINUTES=5

# Escalation System
ESCALATION_INTERVAL_MINUTES=60

# Development/Debug
DRIZZLE_VERBOSE=false